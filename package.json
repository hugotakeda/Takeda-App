{
  "name": "takeda-app",
  "version": "1.1.2",
  "description": "Takeda App - Análise, Limpeza e Otimização do Sistema",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "check": "node scripts/check-project.js",
    "test": "node --test",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "pack": "electron-builder --dir"
  },
  "author": "HonestTech",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.honesttech.takeda",
    "productName": "Takeda App",
    "artifactName": "Takeda-App-Setup-${version}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/takeda.pow",
        "to": "takeda.pow"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/takeda-icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "hugotakeda",
      "repo": "Takeda-App"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Takeda App"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
